{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(npx prisma *)",
      "Bash(npx turbo *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(find . *)",
      "Bash(ls *)",
      "Bash(mkdir -p *)"
    ],
    "deny": [
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git reset*)",
      "Bash(git stash*)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd '/Users/thiranaembuldeniya/Documents/SE/Self Learning Project/grow-logs' && npm run typecheck 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
