          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('response has data envelope', () => pm.expect(body).to.have.property('data'));",
                  "pm.test('data has expected fields', () => {",
                  "  const d = body.data;",
                  "  pm.expect(d).to.have.property('id');",
                  "  pm.expect(d).to.have.property('email');",
                  "  pm.expect(d).to.have.property('role');",
                  "  pm.expect(d).to.have.property('isEmailVerified');",
                  "  pm.expect(d).to.have.property('onboardingCompleted');",
                  "  pm.expect(d).to.have.property('subscriptionStatus');",
                  "  pm.expect(d).to.have.property('createdAt');",
                  "});",
                  "pm.test('passwordHash not exposed', () => pm.expect(body.data).to.not.have.property('passwordHash'));",
                  "pm.test('stripeCustomerId not exposed', () => pm.expect(body.data).to.not.have.property('stripeCustomerId'));"
                ]
              }
            }
          ]
        },
