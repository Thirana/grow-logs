        {
          "name": "Verify Email — happy path (200)",
          "description": "Paste the token printed to the dev server console after registering. In dev mode the server logs: [DEV] Verify: http://localhost:3001/verify-email?token=<TOKEN>. Copy the token value and set it as {{VERIFICATION_TOKEN}} in your environment.",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{BASE_URL}}/auth/verify-email", "host": ["{{BASE_URL}}"], "path": ["auth", "verify-email"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{VERIFICATION_TOKEN}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('response has data envelope', () => pm.expect(body).to.have.property('data'));",
                  "pm.test('data has message', () => pm.expect(body.data).to.have.property('message'));",
                  "pm.test('message confirms verification', () => pm.expect(body.data.message).to.include('verified'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Email — idempotent, second call succeeds (200)",
          "description": "Calling verify-email twice with the same valid token must return 200 both times. Email clients pre-fetch links, so the second call must not error.",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{BASE_URL}}/auth/verify-email", "host": ["{{BASE_URL}}"], "path": ["auth", "verify-email"] },
