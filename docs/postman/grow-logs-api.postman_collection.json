        {
          "name": "Login — happy path",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{BASE_URL}}/auth/login", "host": ["{{BASE_URL}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{USER_EMAIL}}\",\n  \"password\": \"{{USER_PASSWORD}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('response has data envelope', () => pm.expect(body).to.have.property('data'));",
                  "pm.test('data has accessToken', () => pm.expect(body.data).to.have.property('accessToken'));",
                  "pm.test('data has user object', () => pm.expect(body.data).to.have.property('user'));",
                  "pm.test('user has expected fields', () => {",
                  "  const user = body.data.user;",
                  "  pm.expect(user).to.have.property('id');",
                  "  pm.expect(user).to.have.property('email');",
                  "  pm.expect(user).to.have.property('role');",
                  "  pm.expect(user).to.have.property('isEmailVerified');",
                  "  pm.expect(user).to.have.property('onboardingCompleted');",
                  "});",
                  "pm.test('passwordHash not exposed', () => pm.expect(body.data.user).to.not.have.property('passwordHash'));",
                  "if (body.data && body.data.accessToken) {",
                  "  pm.environment.set('ACCESS_TOKEN', body.data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
