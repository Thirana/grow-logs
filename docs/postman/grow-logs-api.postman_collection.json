                  "const body = pm.response.json();",
                  "pm.test('response has statusCode', () => pm.expect(body).to.have.property('statusCode'));",
                  "pm.test('statusCode is 409', () => pm.expect(body.statusCode).to.equal(409));"
                ]
              }
            }
          ]
        },
