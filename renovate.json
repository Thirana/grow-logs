{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["every weekend"],
  "packageRules": [
    {
      "groupName": "NestJS packages",
      "matchPackageNames": [
        "@nestjs/{/,}**"
      ]
    },
    {
      "groupName": "Prisma",
      "matchPackageNames": ["prisma", "@prisma/client"]
    },
    {
      "groupName": "TypeScript and type definitions",
      "matchPackageNames": ["typescript", "@types/{/,}**"]
    },
    {
      "groupName": "ESLint and formatting",
      "matchPackageNames": ["eslint", "prettier", "@eslint/{/,}**", "@typescript-eslint/{/,}**", "eslint-{/,}**"]
    },
    {
      "groupName": "Testing tools",
      "matchPackageNames": ["jest", "ts-jest", "supertest", "@jest/{/,}**"]
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "matchDepTypes": ["dependencies"],
      "automerge": false
    }
  ]
}
